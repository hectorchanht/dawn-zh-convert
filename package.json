{
  "dependencies": {
    "tongwen-core": "4.1.1",
    "tongwen-dict": "1.0.2"
  },
  "description": "Chinese script conversion for Dawn Studio apps: Simplified <-> Traditional (phrase-aware, idempotent), lazy-loaded, never-throw. Engine: tongwen-core + tongwen-dict (both MIT).",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "chinese",
    "traditional",
    "simplified",
    "s2t",
    "t2s",
    "tongwen",
    "zht",
    "zhs",
    "dawn-studio"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "name": "@dawn-studio/zh-convert",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hectorchanht/dawn-zh-convert.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.2.0"
}
